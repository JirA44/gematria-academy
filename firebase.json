{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "**/.*",
      "**/node_modules/**",
      "**/.git/**",
      "**/*.log",
      "**/*.md",
      "**/*.py",
      "**/*.pyc",
      "**/*.bat",
      "**/*.ps1",
      "**/*.backup",
      "**/*.backup_*",
      "**/*backup*",
      "**/tests/**",
      "**/.github/**",
      "**/scripts/**",
      "**/*.spec",
      "**/package*.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=3600"
          }
        ]
      }
    ]
  }
}
