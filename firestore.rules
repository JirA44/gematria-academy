rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Les profils contiennent des données personnelles et ne sont visibles
    // que par leur propriétaire. Cela couvre aussi la lecture du profil
    // utilisée après authentification.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /progression/{progressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Refus par défaut pour toutes les autres collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
